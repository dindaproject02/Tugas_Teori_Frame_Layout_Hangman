<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <!-- ============ LAPISAN 1: PAPAN PERMAINAN ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Baris atas: Judul + Skor + Nyawa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/judul_permainan"
                android:textColor="#e2e8f0"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Latihan 4: Skor -->
            <TextView
                android:id="@+id/tvSkor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="Skor: 0"
                android:textColor="#fbbf24"
                android:textStyle="bold" />

            <!-- Nyawa -->
            <TextView
                android:id="@+id/tvNyawa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nyawa: 6"
                android:textColor="#3ddc84"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ======== AREA GAMBAR: 7 LAPIS GAMBAR DITUMPUK ======== -->
        <FrameLayout
            android:id="@+id/frameGantungan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <!-- LAPIS 1: tiang gantungan, selalu terlihat -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/gambar_gantungan"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_tiang" />

            <!-- LAPIS 2-7: bagian tubuh, muncul satu per satu -->
            <ImageView
                android:id="@+id/imgKepala"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_kepala"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgBadan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_badan"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgTanganKiri"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_tangan_kiri"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgTanganKanan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_tangan_kanan"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgKakiKiri"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_kaki_kiri"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imgKakiKanan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/gambar_kaki_kanan"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Teks Petunjuk di Layar Permainan -->
        <TextView
            android:id="@+id/tvPetunjukPapan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#fbbf24"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- kata rahasia -->
        <TextView
            android:id="@+id/tvKata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.25"
            android:textColor="#ffffff"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- huruf yang sudah ditebak -->
        <TextView
            android:id="@+id/tvRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Salah: -"
            android:textColor="#94a3b8"
            android:textSize="13sp" />

        <!-- Latihan 1: Tombol huruf A-Z -->
        <GridLayout
            android:id="@+id/gridHuruf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alignmentMode="alignMargins"
            android:columnCount="7" />

        <!-- input huruf + tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTebak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="@string/hint_tebak"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:maxLength="1" />

            <Button
                android:id="@+id/btnTebak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_tebak" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ LAPISAN 2: OVERLAY HASIL ============ -->
    <LinearLayout
        android:id="@+id/overlayHasil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#cc0f172a"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Kamu Menang!"
            android:textColor="#3ddc84"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKataAkhir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:textColor="#e2e8f0"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnMainLagi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/btn_main_lagi" />
    </LinearLayout>

    <!-- ============ LAPISAN 3: OVERLAY MULAI ============ -->
    <LinearLayout
        android:id="@+id/overlayMulai"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ee0f172a"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/judul_permainan"
            android:textColor="#3ddc84"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Tebak huruf satu per satu.\nNyawa habis = kalah."
            android:textColor="#94a3b8" />



        <Button
            android:id="@+id/btnMulai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/btn_mulai" />
    </LinearLayout>

    <!-- ============ LAPISAN 4: OVERLAY KESULITAN ============ -->
    <LinearLayout
        android:id="@+id/overlayKesulitan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f00f172a"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/judul_kesulitan"
            android:textColor="#3ddc84"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMudah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_mudah" />

        <Button
            android:id="@+id/btnSedang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_sedang" />

        <Button
            android:id="@+id/btnSulit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_sulit" />
    </LinearLayout>

</FrameLayout>
